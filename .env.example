# Copia este archivo como .env y pon tu clave gratuita de https://api.nasa.gov
# Para `wrangler pages dev` (Cloudflare) copia el mismo contenido a .dev.vars
NASA_API_KEY=TU_CLAVE_AQUI

# Opcional: ruta a blender.exe para "npm run models:build" y "npm run models:reduce" (modelos 3D por script)
BLENDER=C:/ruta/a/blender.exe

# Opcional: URL de tu ComfyUI local para "npm run models:ai3d" (imagen a 3D con IA)
# Comfy Desktop usa el puerto 8000; ComfyUI "a mano" usa el 8188.
COMFYUI_URL=http://127.0.0.1:8188

---
import App from '../app/App';
// Tipografías auto-alojadas (el juego funciona sin red): B612 para texto y números
// y Barlow Condensed para títulos y etiquetas.
import '@fontsource/b612/latin-400.css';
import '@fontsource/b612/latin-700.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/global.css';
// La piel de juego va la última: solo aspecto, no estructura.
import '../styles/skin.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Shackleton: Turno de Noche</title>
		<meta name="description" content="Dirige en primera persona la primera base humana en el polo sur de la Luna." />
	</head>
	<body>
		<App client:only="preact" />
		<script>
			// Solo en desarrollo: revisión automática del HUD (__hudCheck() en la consola).
			if (import.meta.env.DEV) void import('../dev/hudCheck');
		</script>
	</body>
</html>
